# Librarius stores the Anthropic API key OUTSIDE this file, encrypted per-machine
# via Electron safeStorage (Windows DPAPI). You enter it once in Settings on first
# run. This file exists only for development conveniences.

# Optional: pre-seed the Centurion key in DEV ONLY (never set in production builds)
# LIBRARIUS_DEV_ANTHROPIC_API_KEY=sk-ant-placeholder

# Optional: override the Tesseract binary path in dev (defaults to bundled binary)
# LIBRARIUS_TESSERACT_PATH=/usr/bin/tesseract
